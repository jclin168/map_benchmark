include_guard(GLOBAL)
function(map_bench_sparsehash target)
  set(src "${CMAKE_SOURCE_DIR}/external/google__sparsehash")
  set(cfg "${CMAKE_BINARY_DIR}/sparsehash-config")
  if(WIN32)
    target_include_directories(${target} PRIVATE "${src}/src/windows" "${src}/src")
    return()
  endif()
  if(NOT TARGET map_bench_sparsehash_config)
    file(MAKE_DIRECTORY "${cfg}")
    execute_process(COMMAND "${src}/configure" --disable-dependency-tracking
      WORKING_DIRECTORY "${cfg}" RESULT_VARIABLE status
      OUTPUT_FILE "${cfg}/configure.log" ERROR_FILE "${cfg}/configure-error.log")
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "sparsehash configure failed; see ${cfg}/configure-error.log")
    endif()
    find_program(MAP_BENCH_MAKE NAMES gmake make)
    if(NOT MAP_BENCH_MAKE)
      message(FATAL_ERROR "GNU make is required to generate the sparsehash config header")
    endif()
    execute_process(COMMAND "${MAP_BENCH_MAKE}" src/sparsehash/internal/sparseconfig.h
      WORKING_DIRECTORY "${cfg}" RESULT_VARIABLE status
      OUTPUT_FILE "${cfg}/header.log" ERROR_FILE "${cfg}/header-error.log")
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "sparsehash header generation failed; see ${cfg}/header-error.log")
    endif()
    add_custom_target(map_bench_sparsehash_config)
  endif()
  target_include_directories(${target} PRIVATE "${cfg}/src" "${src}/src")
endfunction()
